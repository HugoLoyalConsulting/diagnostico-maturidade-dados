# Conexão com o banco PostgreSQL (Railway fornece automaticamente via variável DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Token do HubSpot (Private App Token — gerado em Settings > Integrations > Private Apps)
HUBSPOT_API_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Origens permitidas pelo CORS (separadas por vírgula)
# Ex: https://seuusuario.github.io,http://localhost:3000
ALLOWED_ORIGINS=https://seuusuario.github.io

# Porta local (Railway define isso automaticamente em produção)
PORT=3000

# Ambiente
NODE_ENV=production
